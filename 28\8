ArrayList<cuadrado> tubos;
  Pelota bird;
float UltimoPar=0;
PVector g =new PVector(0, 0.2);

void setup(){
  size(800, 600);
  tubos= new ArrayList<cuadrado>();
  bird = new Pelota(100, height/2);
}

void draw(){
  background(135, 206, 235);
  AgregarTubos();
  bird.addFuerza(g);
  bird.mover();
  borrarTubos();
  for(cuadrado t :tubos){
    t.mover();
    
    t.mostrar();
  }
  bird.mostrar();
  
}

void borrarTubos(){
  for(int i= tubos.size() - 1; i>=0; i--){
    cuadrado Aux = tubos.get(i);
    if(Aux.pos.x < 0){
      tubos.remove(i);}
}
}

void AgregarTubos() {
  float tActual = millis();
  float dt = tActual - UltimoPar;
  if (dt > 2000) {
    float anchoTubo = 60;
    float altoTubo = random(100, 300);
        tubos.add(new cuadrado(width, 0, 50, altoTubo));
        tubos.add(new cuadrado(width, altoTubo + anchoTubo, height - (altoTubo + anchoTubo)));

    
    UltimoPar = tActual;
  }
}
void keyPressed(){
  if (key == ' '){
    bird.saltar();
  }
}

CLASES:
class Pelota {
  PVector pos;
  PVector vel;
  float r = 20;

  Pelota(float x, float y) {
    pos = new PVector(x, y);
    vel = new PVector(0, 0);
  }

  void addFuerza(PVector fuerza) {
    vel.add(fuerza);
  }

  void saltar() {
    vel.y = -6;
  }

  void mover() {
    pos.add(vel);
    vel.limit(8);
   
 
    if (pos.y > height) pos.y = height;
    if (pos.y < 0) pos.y = 0;
  }

  void mostrar() {
    fill(255, 255, 0);
    ellipse(pos.x, pos.y, r * 2, r * 2);
  }
}

class cuadrado {
  PVector pos;
  float w, h;
  float velocidadX = -3;

  cuadrado(float x, float y, float ancho, float alto) {
    pos = new PVector(x, y);
    w = ancho;
    h = alto;
  }

  cuadrado(float x, float y, float alto) {
    pos = new PVector(x, y);
    w = 50; 
    h = alto;
  }

  void mover() {
    pos.x += velocidadX;
  }

  void mostrar() {
    fill(0, 200, 0);
    rect(pos.x, pos.y, w, h);
  }
}

